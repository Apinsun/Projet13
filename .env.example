# ──────────────────────────────────────────────
# Chess Agent FFE — Configuration
# Copiez ce fichier en `.env` et renseignez vos clés :
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── Ports (optionnel, valeurs par défaut) ──
API_PORT=8000
FRONTEND_PORT=4200
MONGO_PORT=27017
MILVUS_PORT=19530
MILVUS_GRPC_PORT=9091
MINIO_PORT=9001
MINIO_CONSOLE_PORT=9000

# ── YouTube Data API v3 (étape 4) ──
# Obtenir une clé : https://console.cloud.google.com/apis/credentials
# Puis activer "YouTube Data API v3"
# ⚠️ Sans cette clé, l'application fonctionne avec des vidéos de secours (fallback).
YOUTUBE_API_KEY=

# ── Lichess API (étape 2) ──
# Obtenir un token : https://lichess.org/account/oauth/token
# (scope "Opening Explorer" suffit, aucun scope requis en fait)
LICHESS_API_TOKEN=

# ── Mistral AI (LLM pour formuler les réponses) ──
# Obtenir une clé : https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
